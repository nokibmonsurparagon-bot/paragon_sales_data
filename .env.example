# ---------------------------------------------------------------------------
# Paragon – environment configuration
# Copy to `.env` (repo root) and fill in real values. NEVER commit `.env`.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL. `npm run db:start` (embedded) and docker-compose both listen on 5432.
DATABASE_URL=postgresql://paragon:paragon_dev_password@localhost:5432/paragon?schema=public
# Separate database used by the API integration tests (it is wiped on every run).
TEST_DATABASE_URL=postgresql://paragon:paragon_dev_password@localhost:5432/paragon_test?schema=public

# Used only by docker-compose to initialise the postgres container.
POSTGRES_USER=paragon
POSTGRES_PASSWORD=paragon_dev_password
POSTGRES_DB=paragon

# Auth – each secret must be at least 32 characters.
JWT_SECRET=change-me-access-token-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-token-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Cookies are sent only over HTTPS when true. Keep false for plain-http local development.
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Set to the number of reverse proxies in front of the API (e.g. 1 behind nginx).
TRUST_PROXY=0

# File attachments (local storage provider).
FILE_STORAGE_PATH=./storage
MAX_UPLOAD_MB=10

# Swagger UI at /api/docs (defaults to enabled outside production).
SWAGGER_ENABLED=true

# Rate limiting (per IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
